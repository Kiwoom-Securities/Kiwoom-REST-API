# kiwoom-exec-mcp 환경변수 예시 (이 파일을 .env로 복사해 채운다 — 커밋 금지)
# 전체 목록·기본값·파싱 규칙: ../MAINTENANCE.md "환경 변수" 절 (코드: src/kiwoom_exec_mcp/config.py)
# 모두 선택 항목이다. 정수 항목에 숫자가 아닌 값을 넣으면 기동 시 실패한다.

# ─── 로컬 stdio 자격증명 (subprocess kiwoomcli가 읽는 kwcli 변수; HTTP 배포에선 넣지 않는다) ───
# real(실전) | demo(모의투자). 키 이름은 mode와 무관하게 APP_KEY/APP_SECRET 하나만 쓴다
# (demo에서 런타임이 읽는 _MOCK 이름은 서버가 내부에서 매핑한다).
KIWOOM_MODE=demo
APP_KEY=
APP_SECRET=
# (대안) `kiwoomcli setup`을 마친 머신이면 위 키 대신 프로필로 대체 가능(키는 OS keyring):
# KIWOOM_PROFILE=demo

# ─── 서버 설정 KIWOOM_MCP_* ───
# 전송: stdio(기본, 로컬) | http(원격 멀티테넌트 — 자격증명은 요청 헤더로)
# KIWOOM_MCP_TRANSPORT=http
# KIWOOM_MCP_HOST=0.0.0.0
# KIWOOM_MCP_PORT=8000

# 도구 게이트 — 정확히 1일 때만 켜진다
# KIWOOM_MCP_ALLOW_ORDERS=1        # kiwoom_order_preview/submit 등록
# KIWOOM_MCP_DEBUG_HEADERS=1       # 진단 도구(헤더 이름·길이만 반환). 확인 후 되돌린다

# 자원·토큰
# KIWOOM_MCP_MAX_CONCURRENCY=8     # 동시 kiwoomcli subprocess 상한 (OOM 가드)
# KIWOOM_MCP_TOKEN_TTL=900         # 헤더 자격증명별 접근 토큰의 서버 메모리 보관 상한 초 (디스크 없음). 0=요청마다 발급
#                                  #   요청마다 발급하면 키움 au10001 유량(초당 ~2회)에 걸려 동시/연속 조회가 거절된다.

# rate limit 두 축 — 함께 켜야 의미가 있다(한쪽만 켜면 우회된다). 막는 것은 키움 부하가
# 아니라 우리 컨테이너의 subprocess 스폰 비용이다.
# KIWOOM_MCP_RATELIMIT=60          # 윈도우당 최대 요청 / IP (자격증명 유무 무관, 0=off)
# KIWOOM_MCP_RATELIMIT_APPKEY=30   # 윈도우당 최대 요청 / AppKey 지문 (0=off)
# KIWOOM_MCP_RATELIMIT_WINDOW=10   # 윈도우 초 (기본 60; 짧게 잡아야 버스트가 잘린다)
