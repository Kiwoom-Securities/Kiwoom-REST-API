# 운영 REST API base URL입니다.
PRD=https://api.kiwoom.com

# 모의투자 REST API base URL입니다.
MOCK=https://mockapi.kiwoom.com

# 운영 WebSocket endpoint입니다.
W_PRD=wss://api.kiwoom.com:10000

# 모의투자 WebSocket endpoint입니다.
W_MOCK=wss://mockapi.kiwoom.com:10000

# 사용할 인증 모드입니다. 운영은 real, 모의투자는 demo를 사용합니다.
KIWOOM_MODE=real

# 키움 OpenAPI 앱 키입니다. KIWOOM_MODE가 가리키는 환경의 값을 입력합니다.
APP_KEY=

# 키움 OpenAPI 앱 시크릿입니다. KIWOOM_MODE가 가리키는 환경의 값을 입력합니다.
APP_SECRET=